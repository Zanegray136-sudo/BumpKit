{
  "id": "./",
  "name": "PixelPlan",
  "short_name": "PixelPlan",
  "description": "Plan LED walls: data, power, rigging, cables, pick list and report.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0e1012",
  "theme_color": "#171b1e",
  "categories": ["productivity", "utilities", "business"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Data plan", "short_name": "Data", "url": "./#/data", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Power plan", "short_name": "Power", "url": "./#/power", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Pick list", "short_name": "Pick list", "url": "./#/picklist", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Report and checklist", "short_name": "Report", "url": "./#/report", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "file_handlers": [
    { "action": "./", "name": "PixelPlan project", "accept": { "application/json": [".ledproject.json"] } }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
